# =====================================================================================================================
# .env.qa.local.example - the template for the file that holds your SECRETS.
#
#   1. Copy it:      Copy-Item .env.qa.local.example .env.qa.local        (PowerShell)    cp .env.qa.local.example .env.qa.local
#   2. Fill it in below (remove the "# " in front of the lines you need).
#   3. Never commit it: .gitignore already ignores every .env.*.local file. For another environment copy it to
#      .env.<ENV>.local (ENV=stage -> .env.stage.local).
#
# It overrides .env.qa, and a real environment variable (a masked CI variable, or $env:SAP_PASSWORD = '...') overrides it.
# Write a value with special characters (# $ spaces) in double quotes - an unquoted # starts a comment and cuts the password:
#     SAP_PASSWORD="my#pass word"
# Inside double quotes \n is a line break: use single quotes for a password that contains a backslash.
#
# Every variable marked "Secret: YES" in .env.example is listed here. A WRONG SAP_PASSWORD counts towards SAP's lock limit: check
# it in SAP Logon by hand before you run a test. See SAP_LOGON_FAILURE_COOLDOWN_MIN in .env.example.
# =====================================================================================================================

# The password of SAP_USER (set SAP_USER and SAP_CLIENT in .env.qa). Alternative without a file: npm run secret -- set SAP_PASSWORD
# (Windows only: a DPAPI-protected file that only you can open on this machine).
# SAP_PASSWORD="change-me"

# One password per pooled user (SAP_USER_POOL in .env.qa): replace <USER> with the user name in upper case, e.g. SAP_PASSWORD_QAUSER1.
# SAP_PASSWORD_<USER>="change-me"

# The Windows login of the remote desktop host (SAP_GUI_TRANSPORT=remote with REMOTE_AGENT_START=alternate-shell).
# REMOTE_RDP_PASSWORD="change-me"

# Connection string for SQL on the remote host (not used by the SAP GUI steps).
# REMOTE_DB_CONNECTION_STRING="change-me"

# Secrets that a recorded flow types into a PIN / one-time code / token / secret / api key field: the converter reads them from here.
# SAP_PIN="change-me"
# SAP_OTP="change-me"
# SAP_TOKEN="change-me"
# SAP_SECRET="change-me"
# SAP_API_KEY="change-me"
