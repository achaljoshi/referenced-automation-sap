{
  "name": "@automation/referenced-automation-sap",
  "version": "1.0.0",
  "description": "SAP automation on Playwright: Fiori/UI5 helpers (byControlId, waitForUI5Ready) and a classic SAP GUI framework - a Windows COM bridge with built-in waiting, plus a converter that turns SAP GUI Scripting recordings (VBScript) into Playwright tests.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bridge/jacob/src",
    "bridge/jacob/build.sh",
    "bridge/jacob/build.bat",
    "bridge/jacob/README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf --glob dist \"*.tgz\"",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bddgen && playwright test",
    "test:bdd": "bddgen && playwright test --project=bdd --grep-invert @live --workers=50% && node scripts/min-executed.js --min 5",
    "test:smoke": "bddgen && playwright test --grep @smoke && node scripts/min-executed.js --min 5",
    "test:regression": "bddgen && playwright test --grep @regression",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "install:browsers": "playwright install --with-deps chromium",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "convert": "node dist/cli/convertVbs.js recordings --out tests/sapgui --test-import ./support/sapTest --expect-import ./support/sapTest --strict",
    "test:framework": "bddgen && playwright test tests/gui --workers=50% && node scripts/min-executed.js --min 200",
    "test:sapgui": "playwright test tests/sapgui --grep @sapgui",
    "doctor": "node dist/cli/doctor.js",
    "data": "node dist/cli/data.js",
    "secret": "node dist/cli/secret.js",
    "try:simulator": "node scripts/try-simulator.js",
    "insights": "node dist/cli/insights.js report",
    "contracts": "node dist/cli/contracts.js",
    "convert:pages": "node dist/cli/convertVbs.js recordings --out tests/sapgui --test-import ./support/sapTest --expect-import ./support/sapTest --sap-import ../../../src --page-objects --strict",
    "convert:data": "node dist/cli/convertVbs.js recordings --out tests/sapgui --test-import ./support/sapTest --expect-import ./support/sapTest --sap-import ../../../src --data --strict",
    "conformance": "node dist/cli/doctor.js --conformance",
    "security": "automation-audit-gate --allow-unassigned && automation-scan-secrets",
    "audit": "automation-framework-audit --run",
    "audit:quick": "automation-framework-audit"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.64.0 <2.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.9",
    "eslint": "^8.57.1",
    "playwright-bdd": "9.2.1",
    "playwright-core": "^1.64.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@automation/referenced-automation-ui": "^1.0.0",
    "@automation/referenced-automation-utils": "^1.0.0"
  },
  "bin": {
    "sap-vbs-to-playwright": "./dist/cli/convertVbs.js",
    "sap-gui-doctor": "./dist/cli/doctor.js",
    "sap-gui-secret": "./dist/cli/secret.js",
    "sap-gui-insights": "./dist/cli/insights.js",
    "sap-gui-data": "./dist/cli/data.js",
    "sap-gui-contracts": "./dist/cli/contracts.js"
  }
}
