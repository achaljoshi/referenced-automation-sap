ENV=qa
LOG_LEVEL=info
HEADLESS=true
BASE_URL=https://your-fiori-launchpad-qa.example.com

# Classic SAP GUI - non-secret settings. SAP_PASSWORD goes in .env.<name>.local, never here.
SAP_GUI_MODE=open
SAP_GUI_CONNECTION_NAME=
SAP_CLIENT=100
SAP_USER=
SAP_LANGUAGE=EN
SAP_SAMPLE_TCODE=SU3

# SAP_GUI_REUSE=worker   (worker | test)      SAP_GUI_EVIDENCE=failure   (off | failure | steps)
