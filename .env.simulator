# Used by `npm run try:simulator`: the sample tests against the built-in FAKE SAP, on any OS.
# These are the fake system's made-up credentials - not real, safe to commit.
ENV=simulator
SAP_GUI_SIMULATOR=true
SAP_USER=TESTUSER
SAP_PASSWORD=correct-horse
SAP_CLIENT=100
SAP_LANGUAGE=EN
SAP_SAMPLE_TCODE=SU3
LOG_LEVEL=info
