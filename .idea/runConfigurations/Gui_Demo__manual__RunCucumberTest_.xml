<component name="ProjectRunConfigurationManager">
  <!--
    Runs ONLY the @gui reference scenario. Not part of the default
    "Regression"/"Smoke" configurations, and only meaningful on a Windows
    machine with SAP GUI for Windows + JACOB's native DLL + an already-open
    SAP Logon session - see README "Classic SAP GUI Scripting setup" before
    using this configuration.
  -->
  <configuration default="false" name="GUI Demo (manual, Windows + SAP GUI only)" type="JUnit" factoryName="JUnit">
    <module name="referenced-automation-sap" />
    <option name="MAIN_CLASS_NAME" value="com.company.automation.sap.runners.RunCucumberTest" />
    <option name="TEST_OBJECT" value="class" />
    <option name="VM_PARAMETERS" value="-Denv=qa -Dcucumber.filter.tags=@gui -Djacob.dll.path=C:\path\to\jacob-1.18-x64.dll" />
    <method v="2">
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>
