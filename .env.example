# Copy to .env.<yourenv>.local for secrets that must never be committed.

LOG_LEVEL=info
HEADLESS=true
BASE_URL=https://your-fiori-launchpad.example.com

# ---- Classic SAP GUI (see README > "Getting started with SAP GUI") ----
# Put the real values - especially SAP_PASSWORD - in .env.<name>.local (e.g. .env.qa.local),
# which git ignores. Never in a committed file.
SAP_GUI_MODE=attach                  # attach = use the SAP Logon window you already have open | open = open SAP_GUI_CONNECTION_NAME
SAP_GUI_CONNECTION_NAME=             # exactly as listed in SAP Logon, e.g. "QA1 - ERP Quality"   (only for mode=open)
SAP_CLIENT=100
SAP_USER=
SAP_PASSWORD=
SAP_LANGUAGE=EN
SAP_SAMPLE_TCODE=SU3                 # a transaction your user may open, for tests/sapgui/02_open_transaction
# SAP_GUI_LOGON_PATH=C:\Program Files (x86)\SAP\FrontEnd\SAPgui\saplogon.exe
# SAP_GUI_TIMEOUT_MS=30000
# SAP_GUI_SIMULATOR=true             # run the sample tests against a built-in fake SAP, on any OS

# Session handling (see docs/SAP_GUI_GUIDE.md)
# SAP_GUI_REUSE=worker               worker = one SAP session per worker, reset between tests | test = fresh connection per test
# SAP_GUI_EVIDENCE=failure           off | failure | steps
# SAP_GUI_CONNECTION_STRING=         open a system by connection string instead of a SAP Logon entry (mode=open)
# SAP_MULTIPLE_LOGON=continue        continue | fail  when SAP says the user is already logged on
# Password: SAP_PASSWORD here/in .env.<name>.local, or protect it with:  npx sap-gui-secret set SAP_PASSWORD
