# Copy to .env.<yourenv>.local for secrets that must never be committed.

LOG_LEVEL=info
HEADLESS=true
BASE_URL=https://your-fiori-launchpad.example.com

# ---- Classic SAP GUI (see README > "Getting started with SAP GUI") ----
# Put the real values - especially SAP_PASSWORD - in .env.<name>.local (e.g. .env.qa.local),
# which git ignores. Never in a committed file.
SAP_GUI_MODE=attach                  # attach = use the SAP Logon window you already have open | open = open SAP_GUI_CONNECTION_NAME
SAP_GUI_CONNECTION_NAME=             # exactly as listed in SAP Logon, e.g. "QA1 - ERP Quality"   (only for mode=open)
SAP_CLIENT=100
SAP_USER=
SAP_PASSWORD=
SAP_LANGUAGE=EN
SAP_SAMPLE_TCODE=SU3                 # a transaction your user may open, for tests/sapgui/02_open_transaction
# SAP_GUI_LOGON_PATH=C:\Program Files (x86)\SAP\FrontEnd\SAPgui\saplogon.exe
# SAP_GUI_TIMEOUT_MS=30000
# SAP_GUI_SIMULATOR=true             # run the sample tests against a built-in fake SAP, on any OS

# Session handling (see docs/SAP_GUI_GUIDE.md)
# SAP_GUI_REUSE=worker               worker = one SAP session per worker, reset between tests | test = fresh connection per test
# SAP_GUI_EVIDENCE=failure           off | failure | steps
# SAP_GUI_CONNECTION_STRING=         open a system by connection string instead of a SAP Logon entry (mode=open)
# SAP_MULTIPLE_LOGON=continue        continue | fail  when SAP says the user is already logged on
# Password: SAP_PASSWORD here/in .env.<name>.local, or protect it with:  npx sap-gui-secret set SAP_PASSWORD
# SAP_GUI_ROUNDTRIP_WAIT_MS=250      how long to wait for the server's answer after an action (raise on a slow link; 0 = old "idle twice" check)
# SAP_GUI_CLEANUP_FAILURE=fail       warn = a failed cleanup of test data is only recorded (default: the test fails)
# SAP_GUI_HOME_FAILURE=fail          warn = run the test even if the session could not return to the start screen
# SAP_GUI_POWERSHELL_SCRIPT_DIR=     folder with an approved/signed sap-gui-bridge.ps1: run without -ExecutionPolicy Bypass (see docs/SAP_GUI_GUIDE.md)
# WORKERS=                           ignored in SAP_GUI_MODE=attach (one SAP window = one worker); honoured for the simulator and mode=open

# SAP GUI on a remote desktop host (RDP) - NOT VERIFIED on a real RDP host with real SAP GUI (tested against stand-ins only)
# SAP_GUI_TRANSPORT=remote runs the bridge on the host through the remote agent. The REMOTE_* keys (REMOTE_ENABLED=true, REMOTE_RDP_HOST, REMOTE_RDP_USER,
# REMOTE_RDP_PASSWORD in .env.<name>.local, REMOTE_ALLOW incl. sap ...) are described in referenced-automation-utils docs/REMOTE_DESKTOP.md.
# Always one worker; the RDP session must stay connected and unlocked.
# SAP_GUI_TRANSPORT=remote           powershell (default) | java | remote
# SAP_GUI_REMOTE_BRIDGE_FILE=        path ON THE REMOTE HOST of an approved bridge script, run instead of the one this package ships
# REMOTE_ENABLED=true
# REMOTE_RDP_HOST=rdp-host.example.internal
# REMOTE_ALLOW=http,db,sap           must include sap

