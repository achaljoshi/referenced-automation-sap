# =====================================================================================================================
# .env.example - EVERY setting this repo reads, what it is for, and where to find the value.
#
# How the files work (the shared config, loaded in this order - later wins):
#     .env  ->  .env.<ENV>  ->  .env.<ENV>.local  ->  real environment variables (PowerShell: $env:NAME = "value")
#   * Pick the file with ENV (default qa): ENV=dev runs with .env.dev. In PowerShell: $env:ENV = "dev"
#   * .env.<ENV> (.env.qa, .env.dev, ...) is committed and holds NO secrets.
#   * .env.<ENV>.local (e.g. .env.qa.local) is git-ignored and holds the SECRETS. A template is in .env.qa.local.example.
#   * A variable set in your shell wins over every file. If a value "does not take", look at: Get-ChildItem Env:SAP_*
#
# Each variable has a comment block directly above it:
#     What      what it is for
#     Values    what is accepted
#     Default   what applies when it is not set
#     Required  whether you must set it, and when
#     Secret    NO, or YES = it belongs in .env.<ENV>.local (or a CI "masked" variable), never in a committed file
#     Find it   where to read the value in SAP GUI / SAP Logon
# Optional variables are commented out (a leading "# "): remove the "# " to use them. Do not leave one active with an empty value.
#
# Quoting: write a value with special characters (# $ spaces, a leading or trailing space) in double quotes: SAP_PASSWORD="my#pass word".
# An unquoted # starts a comment and silently cuts the value. Inside double quotes \n is a line break: use single quotes for a
# password that contains a backslash.
#
# tests/gui/envDocs.spec.ts keeps this file in step with the code: a variable the code reads that is missing here, or a variable
# listed here that nothing reads, fails the test run.
# =====================================================================================================================


# ---------------------------------------------------------------------------------------------------------------------
# 1. FILL THESE FIRST - enough to run the first test against your SAP
# ---------------------------------------------------------------------------------------------------------------------

# What:     which .env.<ENV> file (and .env.<ENV>.local) is loaded.
# Values:   any name you have a file for: qa, stage, dev, simulator ...
# Default:  qa
# Required: no
# Secret:   NO
# Find it:  you choose it. PowerShell: $env:ENV = "dev"   (undo: Remove-Item Env:ENV)
ENV=qa

# What:     how the test gets its SAP GUI session.
# Values:   attach = use the SAP Logon window you already have open (never opens or closes anything; start from SAP Easy Access)
#           open   = open SAP_GUI_CONNECTION_NAME itself and start at the LOGON SCREEN (what CI needs)
# Default:  attach
# Required: no
# Secret:   NO
# Find it:  you choose it. Recording a logon? use open. Recording inside SAP? attach (or open with the loggedInSap fixture).
SAP_GUI_MODE=attach

# What:     the SAP Logon entry to open (mode=open).
# Values:   the entry exactly as SAP Logon lists it, e.g. QA1 - ERP Quality
# Default:  (none)
# Required: YES with SAP_GUI_MODE=open, unless SAP_GUI_CONNECTION_STRING is set. Not used in attach mode.
# Secret:   NO
# Find it:  open SAP Logon: it is the system you double-click, spelled exactly as in the list (case and spaces count).
# SAP_GUI_CONNECTION_NAME=QA1 - ERP Quality

# What:     the client (Mandant) typed on the logon screen.
# Values:   up to 3 digits, e.g. 100
# Default:  (none: the logon screen keeps the system's default client)
# Required: recommended - without it you log on to whatever the system suggests
# Secret:   NO
# Find it:  in SAP: System > Status > "Logon data" > Client (the logon screen shows it too)
SAP_CLIENT=100

# What:     the SAP user the tests log on as (loggedInSap / logon()).
# Values:   a SAP user name, e.g. TESTUSER (SAP user names are upper case; the comparison here ignores case)
# Default:  (none)
# Required: YES whenever a test logs on (SAP_GUI_MODE=open, or attach on the logon screen)
# Secret:   NO (but use a technical test user, never a person's account)
# Find it:  in SAP: System > Status > "Logon data" > User
# SAP_USER=TESTUSER

# What:     the password of SAP_USER.
# Values:   the password. Special characters (# $ spaces) need double quotes: SAP_PASSWORD="my#pass word"
# Default:  (none)
# Required: YES whenever a test logs on. A WRONG password counts towards SAP's lock limit - see SAP_LOGON_FAILURE_COOLDOWN_MIN.
# Secret:   YES - put it in .env.<ENV>.local (template: .env.qa.local.example), a masked CI variable, or `npm run secret -- set SAP_PASSWORD`
# Find it:  your SAP administrator / password manager. Never commit it, never put it in this file.
# SAP_PASSWORD=


# ---------------------------------------------------------------------------------------------------------------------
# 2. LOGON
# ---------------------------------------------------------------------------------------------------------------------

# What:     the logon language (field "Language" on the logon screen). Labels found with getByLabel('...') follow this language.
# Values:   a SAP language key: EN, DE, FR ... (or a number)
# Default:  (none: the user's default language)
# Required: no
# Secret:   NO
# Find it:  in SAP: System > Status > "Logon data" > Language
SAP_LANGUAGE=EN

# What:     what to do when SAP shows "user already logged on elsewhere" (the multiple-logon pop-up) after a correct logon.
# Values:   continue = continue without ending the other sessions   |   fail = stop with an explanation
# Default:  continue
# Required: no
# Secret:   NO
# Find it:  you choose it. A pop-up that stays means the user is logged on in another window.
# SAP_MULTIPLE_LOGON=continue

# What:     lock-out protection. After SAP rejects a logon ("Name or password is incorrect", user locked) the same client + user +
#           password is NOT typed into SAP again for this many minutes (CI retries, re-runs and the next test would otherwise
#           repeat the wrong logon until SAP locks the user). A changed password, user or client clears it at once.
# Values:   a number of minutes; 0 turns the protection off (not advised on a shared system)
# Default:  15
# Required: no
# Secret:   NO
# Find it:  the marker is the file SAP_GUI_LOGON_MARKER_DIR/logon-failed.json; delete it once the password or the user is fixed in SAP.
# SAP_LOGON_FAILURE_COOLDOWN_MIN=15

# What:     the folder of the logon-failure marker (client, user, a salted fingerprint of the rejected password, time - never the password).
#           NOT under test-results: Playwright empties that folder at the start of every run. In CI point it at a folder that survives
#           between pipelines (a cache) if re-runs should be stopped too.
# Values:   a folder path, relative to the folder you run the tests from
# Default:  .sap-state
# Required: no
# Secret:   NO (the folder is git-ignored)
# Find it:  you choose it.
# SAP_GUI_LOGON_MARKER_DIR=.sap-state


# ---------------------------------------------------------------------------------------------------------------------
# 3. SESSION AND TIMING
# ---------------------------------------------------------------------------------------------------------------------

# What:     attach mode: which open SAP Logon connection to use (0 = the first).
# Values:   0, 1, 2 ...
# Default:  0
# Required: no (only in attach mode)
# Secret:   NO
# Find it:  the order of the connections in SAP Logon's window list; with one system open it is 0.
# SAP_GUI_CONNECTION_INDEX=0

# What:     attach mode: which session (window) of that connection (0 = the first).
# Values:   0, 1, 2 ...
# Default:  0
# Required: no (only in attach mode)
# Secret:   NO
# Find it:  the first SAP window you opened for that system is 0.
# SAP_GUI_SESSION_INDEX=0

# What:     open a system by connection string instead of a SAP Logon entry (mode=open). NOT verified on a real SAP GUI release.
# Values:   a SAP GUI connection string, e.g. /H/sap-host.example.com/S/3200
# Default:  (none)
# Required: no
# Secret:   NO
# Find it:  SAP Logon > the entry's Properties > "Application Server" and "Instance Number" (port 32<instance>) or your Basis team.
# SAP_GUI_CONNECTION_STRING=/H/sap-host.example.com/S/3200

# What:     the longest any ONE step waits (for a control to appear, for SAP to become idle).
# Values:   milliseconds
# Default:  30000
# Required: no. Raise it for slow systems or long-running transactions.
# Secret:   NO
# Find it:  you choose it.
# SAP_GUI_TIMEOUT_MS=30000

# What:     after an action that should reach the server, how long to wait for SAP's answer before asking whether SAP is idle
#           (also the quiet period for actions that never reach the server, such as a tab switch).
# Values:   milliseconds; 0 = the old "idle twice in a row" check
# Default:  250
# Required: no. Raise it on a slow link (VPN, WAN).
# Secret:   NO
# Find it:  you choose it.
# SAP_GUI_ROUNDTRIP_WAIT_MS=250

# What:     how often a worker connects to SAP.
# Values:   worker = one SAP session per Playwright worker, reused by its tests and reset to the start screen between them
#           test   = a fresh connection for every test (slower; for flows that must start at the logon screen)
# Default:  worker
# Required: no
# Secret:   NO
# Find it:  you choose it.
# SAP_GUI_REUSE=worker

# What:     what to do when the session cannot be returned to the start screen before a test.
# Values:   fail = the test fails   |   warn = log it and run the test anyway
# Default:  fail
# Required: no
# Secret:   NO
# Find it:  you choose it.
# SAP_GUI_HOME_FAILURE=fail

# What:     what to do when a locator's usual id is gone but its fallback (.orElse(...)) finds the control ("locator drift").
# Values:   report = continue and record the drift   |   fail = fail naming the new id   |   off = ignore fallbacks
# Default:  report
# Required: no
# Secret:   NO
# Find it:  you choose it.
# SAP_GUI_FALLBACKS=report

# What:     record transactions and step timings for `npm run insights`.
# Values:   on | off
# Default:  on
# Required: no
# Secret:   NO
# Find it:  you choose it.
# SAP_GUI_INSIGHTS=on

# What:     where the insights files are written.
# Values:   a folder path
# Default:  test-results/sap-insights
# Required: no
# Secret:   NO
# Find it:  you choose it.
# SAP_GUI_INSIGHTS_DIR=test-results/sap-insights

# What:     where screen contracts (baselines of a screen's control ids) are read from and written to.
# Values:   a folder path
# Default:  contracts
# Required: no
# Secret:   NO
# Find it:  you choose it.
# SAP_GUI_CONTRACTS_DIR=contracts

# What:     write the screen contract baselines instead of comparing with them. Refused when CI is set.
# Values:   true | false
# Default:  false
# Required: no. Use it once, on a workstation, on the right screen; review and commit the file.
# Secret:   NO
# Find it:  you choose it. PowerShell: $env:SAP_GUI_UPDATE_CONTRACTS = "true"   (undo: Remove-Item Env:SAP_GUI_UPDATE_CONTRACTS)
# SAP_GUI_UPDATE_CONTRACTS=false


# ---------------------------------------------------------------------------------------------------------------------
# 4. EVIDENCE (what goes into the report)
# ---------------------------------------------------------------------------------------------------------------------

# What:     which screenshots and step journals are attached to the report.
# Values:   off     = nothing extra
#           failure = step journal, status bar text and a screenshot when a test fails
#           steps   = also a screenshot after every step that changes the screen
# Default:  failure
# Required: no
# Secret:   NO (a screenshot shows whatever the screen shows: keep real customer data off the test system's screens)
# Find it:  you choose it. sap.evidence('label') always attaches one.
# SAP_GUI_EVIDENCE=failure

# What:     where screenshots are written before they are attached to the report (and then deleted).
# Values:   a folder path
# Default:  test-results/sap-evidence
# Required: no
# Secret:   NO
# Find it:  you choose it.
# SAP_GUI_EVIDENCE_DIR=test-results/sap-evidence


# ---------------------------------------------------------------------------------------------------------------------
# 5. TEST DATA AND CLEANUP
# ---------------------------------------------------------------------------------------------------------------------

# What:     whether the data a test created in SAP (sapData.record / captureFromStatusBar) is cleaned up afterwards.
# Values:   on | off (off keeps everything for inspection; the objects then show up in `npm run data -- orphans`)
# Default:  on
# Required: no
# Secret:   NO
# Find it:  you choose it.
# SAP_GUI_CLEANUP=on

# What:     what happens when a cleanup fails or an object was recorded without one.
# Values:   fail = the test fails and names what is left in SAP   |   warn = only record it
# Default:  fail
# Required: no
# Secret:   NO
# Find it:  you choose it.
# SAP_GUI_CLEANUP_FAILURE=fail

# What:     the longest one cleanup may run before it is asked to stop.
# Values:   milliseconds
# Default:  60000
# Required: no
# Secret:   NO
# Find it:  you choose it.
# SAP_GUI_CLEANUP_TIMEOUT_MS=60000

# What:     where the list of created objects (what `npm run data` reads) is written.
# Values:   a folder path
# Default:  test-results/sap-data
# Required: no
# Secret:   NO
# Find it:  you choose it.
# SAP_GUI_DATA_DIR=test-results/sap-data


# ---------------------------------------------------------------------------------------------------------------------
# 6. USER POOL (parallel workers, SAP_GUI_MODE=open): every worker logs on as its own user, so SAP never says "already logged on"
# ---------------------------------------------------------------------------------------------------------------------

# What:     the users the workers lease, one per worker.
# Values:   a comma-separated list of SAP user names, e.g. QAUSER1,QAUSER2,QAUSER3
# Default:  (none: every worker uses SAP_USER)
# Required: no. Ignored in attach mode.
# Secret:   NO
# Find it:  technical test users your SAP administrator created for this (same authorisations).
# SAP_USER_POOL=QAUSER1,QAUSER2,QAUSER3

# What:     the password of one pooled user (replace <USER> with the user name in upper case: SAP_PASSWORD_QAUSER1).
# Values:   the password (double quotes for special characters)
# Default:  the shared SAP_PASSWORD
# Required: only if the pooled users have different passwords
# Secret:   YES - .env.<ENV>.local or a masked CI variable
# Find it:  your SAP administrator.
# SAP_PASSWORD_<USER>=

# What:     users are leased exclusively per scope; two runs that use the same SAP system must share the scope.
# Values:   any text
# Default:  SAP_GUI_CONNECTION_NAME, or "default"
# Required: no
# Secret:   NO
# Find it:  you choose it.
# SAP_GUI_POOL_SCOPE=QA1 - ERP Quality

# What:     the folder of the lease files (a file lock that works across processes on ONE machine).
# Values:   a folder path
# Default:  <the OS temp folder>/sap-user-pool
# Required: no. Several CI machines that share users cannot coordinate through a folder: give each machine its own users.
# Secret:   NO
# Find it:  you choose it.
# SAP_GUI_POOL_DIR=C:\Temp\sap-user-pool

# What:     how long a worker waits for a free user before it fails.
# Values:   milliseconds
# Default:  120000
# Required: no
# Secret:   NO
# Find it:  you choose it.
# SAP_GUI_POOL_TIMEOUT_MS=120000


# ---------------------------------------------------------------------------------------------------------------------
# 7. TRANSPORTS - how the framework reaches SAP GUI (the default needs nothing installed)
# ---------------------------------------------------------------------------------------------------------------------

# What:     which bridge talks to SAP GUI.
# Values:   powershell = the PowerShell bridge (default)
#           java       = the Java/JACOB helper (bridge/jacob; see the Java keys below)
#           remote     = the PowerShell bridge on a remote desktop host through RDP (see the REMOTE_* keys below; one worker)
# Default:  powershell
# Required: no
# Secret:   NO
# Find it:  powershell unless IT blocks PowerShell scripts (then java) or SAP GUI lives on another machine (then remote).
# SAP_GUI_TRANSPORT=powershell

# --- PowerShell ---

# What:     the PowerShell that runs the bridge.
# Values:   a path to powershell.exe. A 32-bit SAP GUI needs C:\Windows\SysWOW64\WindowsPowerShell\v1.0\powershell.exe
# Default:  powershell.exe
# Required: no. Set it when every step fails with COM errors on a 32-bit SAP GUI.
# Secret:   NO
# Find it:  where saplogon.exe is installed: under "Program Files (x86)" it is the 32-bit SAP GUI (then you need the SysWOW64 one).
# SAP_GUI_POWERSHELL=C:\Windows\SysWOW64\WindowsPowerShell\v1.0\powershell.exe

# What:     a folder with an approved (typically signed) copy of the bridge script, run as it is without -ExecutionPolicy Bypass.
#           A copy that differs from this version's script is refused.
# Values:   a folder path containing sap-gui-bridge.ps1 (create it: node dist/cli/doctor.js --print-bridge | Out-File -Encoding ascii sap-gui-bridge.ps1)
# Default:  (none: the bridge runs from a temp file with -ExecutionPolicy Bypass for that one process)
# Required: no. Ask IT whether they want it.
# Secret:   NO
# Find it:  your IT security team.
# SAP_GUI_POWERSHELL_SCRIPT_DIR=C:\approved\sap-bridge

# What:     saplogon.exe, started in open mode when SAP Logon is not running yet.
# Values:   the full path of saplogon.exe
# Default:  C:\Program Files (x86)\SAP\FrontEnd\SAPgui\saplogon.exe
# Required: no. Set it when SAP GUI is installed elsewhere.
# Secret:   NO
# Find it:  right-click the SAP Logon shortcut > Open file location.
# SAP_GUI_LOGON_PATH=C:\Program Files (x86)\SAP\FrontEnd\SAPgui\saplogon.exe

# --- Java / JACOB (SAP_GUI_TRANSPORT=java; build the helper first: bridge/jacob/README.md) ---

# What:     the java executable that runs the helper. Its bitness (32/64) must match the JACOB DLL.
# Values:   a path to java.exe
# Default:  java from PATH
# Required: no
# Secret:   NO
# Find it:  where your JDK/JRE is installed, e.g. C:\Program Files\Java\jdk-17\bin\java.exe
# SAP_GUI_JAVA=C:\Program Files\Java\jdk-17\bin\java.exe

# What:     the helper you built: bridge/jacob/sap-bridge.jar.
# Values:   the full path of the jar
# Default:  (none)
# Required: YES with SAP_GUI_TRANSPORT=java
# Secret:   NO
# Find it:  build it with bridge\jacob\build.bat <jacob.jar>; it is written next to the build script.
# SAP_GUI_BRIDGE_JAR=C:\work\referenced-automation-sap\bridge\jacob\sap-bridge.jar

# What:     the JACOB library (the BINARY jar, not the -sources jar).
# Values:   the full path of the jar, e.g. jacob-1.18.jar
# Default:  (none)
# Required: YES with SAP_GUI_TRANSPORT=java
# Secret:   NO
# Find it:  where the existing Java framework keeps it.
# SAP_GUI_JACOB_JAR=C:\tools\jacob\jacob-1.18.jar

# What:     the JACOB DLL in the bitness of your Java (x64 DLL with 64-bit Java, x86 DLL with 32-bit Java): what the old framework passed as jacob.dll.path.
# Values:   the FULL path of the DLL
# Default:  (none)
# Required: YES with SAP_GUI_TRANSPORT=java
# Secret:   NO
# Find it:  next to the JACOB jar: jacob-1.18-x64.dll / jacob-1.18-x86.dll.
# SAP_GUI_JACOB_DLL=C:\tools\jacob\jacob-1.18-x64.dll

# --- Remote desktop host (SAP_GUI_TRANSPORT=remote): SAP GUI is on a Windows host that you reach by RDP. NOT verified on a real RDP host.
#     The REMOTE_* keys are read by referenced-automation-utils' remote client (its docs/REMOTE_DESKTOP.md has the full description).

# What:     a bridge script that is already ON THE REMOTE HOST (an approved or signed copy), run instead of the text this package sends.
# Values:   a path on the remote host
# Default:  (none)
# Required: no
# Secret:   NO
# Find it:  your IT security team.
# SAP_GUI_REMOTE_BRIDGE_FILE=C:\approved\sap-gui-bridge.ps1

# What:     switches the remote desktop host on. Without it SAP_GUI_TRANSPORT=remote fails with an explanation.
# Values:   true | false
# Default:  false
# Required: YES with SAP_GUI_TRANSPORT=remote
# Secret:   NO
# Find it:  you choose it.
# REMOTE_ENABLED=true

# What:     the RDP host that has SAP GUI.
# Values:   a host name or address, no scheme or path
# Default:  (none)
# Required: YES with REMOTE_ENABLED=true
# Secret:   NO
# Find it:  your IT / the host's owner.
# REMOTE_RDP_HOST=rdp-host.example.internal

# What:     the RDP port.
# Values:   1-65535
# Default:  3389
# Required: no
# Secret:   NO
# Find it:  your IT.
# REMOTE_RDP_PORT=3389

# What:     the Windows user for the RDP login (DOMAIN\user is accepted).
# Values:   a user name
# Default:  (none)
# Required: YES with REMOTE_AGENT_START=alternate-shell (the default)
# Secret:   NO
# Find it:  your IT.
# REMOTE_RDP_USER=svc-sap-tests

# What:     the Windows domain of the RDP user (alternative to writing DOMAIN\user).
# Values:   a domain name
# Default:  (none)
# Required: no
# Secret:   NO
# Find it:  your IT.
# REMOTE_RDP_DOMAIN=CORP

# What:     the password of the RDP user.
# Values:   the password (double quotes for special characters)
# Default:  (none)
# Required: YES with REMOTE_AGENT_START=alternate-shell
# Secret:   YES - .env.<ENV>.local or a masked CI variable
# Find it:  your IT / password manager.
# REMOTE_RDP_PASSWORD=

# What:     the folder on the test machine through which request and reply files travel (the drive-mailbox).
# Values:   a folder path
# Default:  .remote-mailbox in the working directory (git-ignored)
# Required: no
# Secret:   NO
# Find it:  you choose it.
# REMOTE_SHARE_DIR=.remote-mailbox

# What:     the drive letter under which that folder appears inside the RDP session (\\tsclient\R).
# Values:   one letter other than A, B, C
# Default:  R
# Required: no
# Secret:   NO
# Find it:  any spare letter.
# REMOTE_DRIVE_LETTER=R

# What:     how the agent is started inside the RDP session.
# Values:   alternate-shell (this machine logs in for you) | startup (the agent is in the host's Startup folder; you open the session) | manual
# Default:  alternate-shell
# Required: no
# Secret:   NO
# Find it:  see referenced-automation-utils docs/REMOTE_DESKTOP.md.
# REMOTE_AGENT_START=alternate-shell

# What:     what the agent may be asked to do on the host.
# Values:   a comma-separated list of http, db, sap, exec. It must include sap. Do not add exec unless you need it (it runs arbitrary commands).
# Default:  http,db,sap
# Required: no
# Secret:   NO
# Find it:  you choose it.
# REMOTE_ALLOW=http,db,sap

# What:     how long to wait for the RDP session and the agent to come up.
# Values:   milliseconds
# Default:  180000
# Required: no
# Secret:   NO
# Find it:  you choose it.
# REMOTE_CONNECT_TIMEOUT_MS=180000

# What:     how long one request to the agent may take before the bridge is stopped.
# Values:   milliseconds
# Default:  60000
# Required: no
# Secret:   NO
# Find it:  you choose it.
# REMOTE_REQUEST_TIMEOUT_MS=60000

# What:     how often the mailbox folder is looked at.
# Values:   10-10000 milliseconds
# Default:  200
# Required: no
# Secret:   NO
# Find it:  you choose it.
# REMOTE_POLL_MS=200

# What:     how often the agent writes its heartbeat.
# Values:   100-60000 milliseconds
# Default:  2000
# Required: no
# Secret:   NO
# Find it:  you choose it.
# REMOTE_HEARTBEAT_MS=2000

# What:     how old a heartbeat may get before the agent counts as dead (at least twice REMOTE_HEARTBEAT_MS).
# Values:   milliseconds
# Default:  10000
# Required: no
# Secret:   NO
# Find it:  you choose it.
# REMOTE_HEARTBEAT_STALE_MS=10000

# What:     the size of the RDP window.
# Values:   200-8192 pixels each
# Default:  1280 x 800
# Required: no
# Secret:   NO
# Find it:  you choose it.
# REMOTE_RDP_WIDTH=1280
# What:     the height of the RDP window (see REMOTE_RDP_WIDTH).
# Values:   200-8192 pixels
# Default:  800
# Required: no
# Secret:   NO
# Find it:  you choose it.
# REMOTE_RDP_HEIGHT=800

# What:     leave the RDP window open after the run.
# Values:   true | false
# Default:  false
# Required: no
# Secret:   NO
# Find it:  you choose it.
# REMOTE_RDP_KEEP_OPEN=false

# What:     log the remote user off at the end of the run.
# Values:   true | false
# Default:  false
# Required: no
# Secret:   NO
# Find it:  you choose it.
# REMOTE_LOGOFF=false

# What:     database provider for steps that run SQL on the host. Not used by the SAP GUI steps; read by the shared remote client.
# Values:   as described in referenced-automation-utils docs/REMOTE_DESKTOP.md
# Default:  (none)
# Required: no
# Secret:   NO
# Find it:  your DBA.
# REMOTE_DB_PROVIDER=

# What:     connection string for SQL on the host. Not used by the SAP GUI steps; read by the shared remote client.
# Values:   a connection string (it usually contains a password)
# Default:  (none)
# Required: no
# Secret:   YES - .env.<ENV>.local or a masked CI variable
# Find it:  your DBA.
# REMOTE_DB_CONNECTION_STRING=


# ---------------------------------------------------------------------------------------------------------------------
# 8. SIMULATOR AND THE SAMPLE TESTS
# ---------------------------------------------------------------------------------------------------------------------

# What:     run against the built-in fake SAP instead of a real one, on any OS (what `npm run try:simulator` sets). Its logon is
#           user TESTUSER, password correct-horse, client 100 (made-up values in .env.simulator).
# Values:   true | false
# Default:  false
# Required: no
# Secret:   NO
# Find it:  you choose it.
# SAP_GUI_SIMULATOR=true

# What:     the transaction tests/sapgui/02_open_transaction.spec.ts opens.
# Values:   a transaction code your user may open
# Default:  SU3
# Required: no
# Secret:   NO
# Find it:  any transaction your user can start from SAP Easy Access.
SAP_SAMPLE_TCODE=SU3

# What:     also run the sample tests marked TEMPLATE / EXAMPLE (03_create_sales_order, 04_example_every_feature) against a REAL SAP.
#           They create data with ids and values that are right for the simulator, not necessarily for your system: adapt them first.
# Values:   true | false
# Default:  false
# Required: no
# Secret:   NO
# Find it:  you choose it.
# SAP_RUN_TEMPLATES=false


# ---------------------------------------------------------------------------------------------------------------------
# 9. PLAYWRIGHT, LOGGING AND THE FIORI HALF (read by the shared config in referenced-automation-utils; defaults are its own)
# ---------------------------------------------------------------------------------------------------------------------

# What:     how many Playwright workers run in parallel. Ignored (one worker) in attach mode and with SAP_GUI_TRANSPORT=remote:
#           one SAP window is one worker.
# Values:   a number, or a percentage like 50%
# Default:  Playwright's own (half the CPUs); 1 in attach mode
# Required: no
# Secret:   NO
# Find it:  you choose it. Parallel workers need the simulator, or mode=open with SAP_USER_POOL.
# WORKERS=1

# What:     how often a failed test is retried. Careful: a retry that logs on with a wrong password repeats the wrong logon
#           (the logon cooldown stops that; see SAP_LOGON_FAILURE_COOLDOWN_MIN).
# Values:   a number
# Default:  0 locally, 2 in CI (when CI is set)
# Required: no
# Secret:   NO
# Find it:  you choose it.
# RETRIES=0

# What:     the longest one whole test may run.
# Values:   milliseconds
# Default:  60000
# Required: no. Raise it for long business flows.
# Secret:   NO
# Find it:  you choose it.
# TEST_TIMEOUT_MS=60000

# What:     the wait of Playwright's own expect (the SAP assertions wait 5 seconds unless you pass { timeout }).
# Values:   milliseconds
# Default:  10000
# Required: no
# Secret:   NO
# Find it:  you choose it.
# EXPECT_TIMEOUT_MS=10000

# What:     the wait of one browser action (Fiori half only).
# Values:   milliseconds
# Default:  15000
# Required: no
# Secret:   NO
# Find it:  you choose it.
# ACTION_TIMEOUT_MS=15000

# What:     the wait of one browser navigation (Fiori half only).
# Values:   milliseconds
# Default:  30000
# Required: no
# Secret:   NO
# Find it:  you choose it.
# NAVIGATION_TIMEOUT_MS=30000

# What:     the longest the whole run may take (0 = no limit).
# Values:   milliseconds
# Default:  0
# Required: no
# Secret:   NO
# Find it:  you choose it.
# GLOBAL_TIMEOUT_MS=0

# What:     stop the run after this many failed tests (0 = never).
# Values:   a number
# Default:  0
# Required: no
# Secret:   NO
# Find it:  you choose it.
# MAX_FAILURES=0

# What:     the Fiori launchpad of the system under test (Fiori half only; the SAP GUI tests do not use it).
# Values:   a URL
# Default:  (none)
# Required: only for Fiori tests
# Secret:   NO
# Find it:  your Fiori launchpad's address in the browser.
BASE_URL=https://your-fiori-launchpad.example.com

# What:     show the browser window (Fiori half only).
# Values:   true | false
# Default:  true
# Required: no
# Secret:   NO
# Find it:  you choose it.
HEADLESS=true

# What:     the browser (Fiori half only).
# Values:   chromium | firefox | webkit | msedge | chrome | all | all-devices
# Default:  chromium
# Required: no
# Secret:   NO
# Find it:  you choose it.
# BROWSER=chromium

# What:     emulate a Playwright device (overrides BROWSER).
# Values:   a Playwright device name, e.g. iPhone 15
# Default:  (none)
# Required: no
# Secret:   NO
# Find it:  Playwright's device list.
# DEVICE=

# What:     slow every browser action down (debugging).
# Values:   milliseconds
# Default:  0
# Required: no
# Secret:   NO
# Find it:  you choose it.
# SLOW_MO_MS=0

# What:     accept invalid HTTPS certificates (Fiori half only).
# Values:   true | false
# Default:  false
# Required: no
# Secret:   NO
# Find it:  you choose it.
# IGNORE_HTTPS_ERRORS=false

# What:     the browser's locale (Fiori half only).
# Values:   a locale, e.g. en-US
# Default:  (none: the browser's)
# Required: no
# Secret:   NO
# Find it:  you choose it.
# LOCALE=en-US

# What:     the browser's time zone (Fiori half only).
# Values:   an IANA time zone, e.g. Europe/Berlin
# Default:  (none: the machine's)
# Required: no
# Secret:   NO
# Find it:  you choose it.
# TIMEZONE_ID=Europe/Berlin

# What:     the browser's colour scheme (Fiori half only).
# Values:   light | dark | no-preference
# Default:  (none)
# Required: no
# Secret:   NO
# Find it:  you choose it.
# COLOR_SCHEME=light

# What:     the browser window size (Fiori half only).
# Values:   pixels
# Default:  1280
# Required: no
# Secret:   NO
# Find it:  you choose it.
# VIEWPORT_WIDTH=1280
# What:     the browser window height (see VIEWPORT_WIDTH).
# Values:   pixels
# Default:  800
# Required: no
# Secret:   NO
# Find it:  you choose it.
# VIEWPORT_HEIGHT=800

# What:     the attribute getByTestId() reads (Fiori half only).
# Values:   an attribute name
# Default:  data-testid
# Required: no
# Secret:   NO
# Find it:  your web app's markup.
# TEST_ID_ATTRIBUTE=data-testid

# What:     how much the logger prints. Read by the shared logger straight from the real environment ($env:LOG_LEVEL), not from the .env files.
# Values:   debug | info | warn | error
# Default:  info
# Required: no
# Secret:   NO (passwords are masked in every log line)
# Find it:  you choose it. debug shows every SAP step.
LOG_LEVEL=info

# What:     write the log to a file as well (real environment only, like LOG_LEVEL).
# Values:   true | false
# Default:  true
# Required: no
# Secret:   NO
# Find it:  you choose it.
# LOG_TO_FILE=true

# What:     the log file (real environment only).
# Values:   a file path
# Default:  logs/automation.log
# Required: no
# Secret:   NO
# Find it:  you choose it.
# LOG_FILE=logs/automation.log

# What:     one log file per Playwright worker instead of one shared file (real environment only).
# Values:   true | false
# Default:  false
# Required: no
# Secret:   NO
# Find it:  you choose it.
# LOG_FILE_PER_WORKER=false


# ---------------------------------------------------------------------------------------------------------------------
# 10. CI, SETUP AND WHAT PLAYWRIGHT SETS
# ---------------------------------------------------------------------------------------------------------------------

# What:     marks a CI run: more retries, no .only, and screen contracts cannot be rewritten. Most CI systems set it for you.
# Values:   any non-empty value except 0 / false
# Default:  (unset)
# Required: no
# Secret:   NO
# Find it:  set by GitLab CI / GitHub Actions / Jenkins.
# CI=true

# What:     scripts/min-executed.js (the end of `npm run test:smoke`, `test:framework`): the run fails when fewer tests executed than this.
# Values:   a number
# Default:  1 (the npm scripts pass --min themselves)
# Required: no
# Secret:   NO
# Find it:  you choose it.
# MIN_EXECUTED=5

# What:     setup scripts (scripts/setup.sh, setup.bat): the npm registry that serves the @automation/* packages.
#           NOTE: the setup scripts run `npm config set registry` with it - that changes your npm settings.
# Values:   a registry URL
# Default:  (unset: npm keeps the registry it is configured with)
# Required: only if the packages come from your organisation's registry
# Secret:   NO (a token for the registry belongs in your user .npmrc, not here)
# Find it:  your platform team (the registry of your Artifactory).
# NPM_REGISTRY_URL=https://registry.example.com/npm/

# What:     setup scripts: install the @automation/* packages from locally built tarballs (same as --local).
# Values:   1
# Default:  (unset)
# Required: no
# Secret:   NO
# Find it:  you choose it.
# USE_LOCAL_PACKAGES=1

# What:     setup scripts: skip downloading the Playwright browser (the SAP GUI tests do not need one).
# Values:   1
# Default:  (unset: the browser is downloaded)
# Required: no
# Secret:   NO
# Find it:  you choose it.
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# What:     the number of the worker Playwright is running this test in. SET BY PLAYWRIGHT - never set it yourself.
# Values:   0, 1, 2 ...
# Default:  set by the runner
# Required: no
# Secret:   NO
# Find it:  Playwright sets it.
# TEST_WORKER_INDEX=

# What:     the parallel slot of the worker. SET BY PLAYWRIGHT - never set it yourself.
# Values:   0, 1, 2 ...
# Default:  set by the runner
# Required: no
# Secret:   NO
# Find it:  Playwright sets it.
# TEST_PARALLEL_INDEX=


# ---------------------------------------------------------------------------------------------------------------------
# 11. SECRETS A RECORDING MAY NEED (the converter replaces what you typed into such a field with a read of one of these)
# ---------------------------------------------------------------------------------------------------------------------

# What:     a PIN that a recorded flow types into a PIN field.
# Values:   the PIN
# Default:  (none)
# Required: only for recordings that type a PIN
# Secret:   YES - .env.<ENV>.local or a masked CI variable
# Find it:  whoever issued the PIN.
# SAP_PIN=

# What:     a one-time code that a recorded flow types into an OTP field.
# Values:   the code
# Default:  (none)
# Required: only for recordings that type a one-time code
# Secret:   YES - .env.<ENV>.local or a masked CI variable
# Find it:  your authenticator; a one-time code cannot be stored: a real flow needs a test double or a service account without one.
# SAP_OTP=

# What:     a token that a recorded flow types into a token field.
# Values:   the token
# Default:  (none)
# Required: only for recordings that type a token
# Secret:   YES - .env.<ENV>.local or a masked CI variable
# Find it:  whoever issued the token.
# SAP_TOKEN=

# What:     any other secret a recorded flow types into a field called "secret".
# Values:   the secret
# Default:  (none)
# Required: only for such recordings
# Secret:   YES - .env.<ENV>.local or a masked CI variable
# Find it:  whoever owns it.
# SAP_SECRET=

# What:     an API key a recorded flow types into an "api key" field.
# Values:   the key
# Default:  (none)
# Required: only for such recordings
# Secret:   YES - .env.<ENV>.local or a masked CI variable
# Find it:  whoever issued the key.
# SAP_API_KEY=
